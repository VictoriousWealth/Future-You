{
  "name": "future-you",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx scripts/build-with-runtime-secrets-isolated.ts",
    "start": "next start",
    "lint": "eslint src tests vitest.config.ts playwright.config.ts playwright.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:evaluation": "vitest run tests/conversation-evaluation-corpus.test.ts tests/conversation-evaluation-corpus-v2.test.ts tests/timing-contract-v3.test.ts tests/scenario-reference-clarification-correction.test.ts",
    "test:evaluation:harness": "node --conditions=react-server --import tsx scripts/run-live-conversation-evaluation.ts --provider=fake",
    "test:evaluation:live": "node --conditions=react-server --import tsx scripts/run-live-conversation-evaluation.ts",
    "openai:readiness": "node --conditions=react-server --import tsx scripts/check-openai-readiness.ts",
    "openai:secret-boundary": "node --import tsx scripts/check-openai-secret-boundary.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:demo": "npm run build && playwright test --config playwright.demo.config.ts",
    "db:seed:generate": "tsx scripts/generate-supabase-seed.ts",
    "db:reset": "npm run db:seed:generate && supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:types:generate": "supabase gen types typescript --local --schema public > src/infrastructure/supabase/database.types.ts",
    "db:artifacts:check": "tsx scripts/check-supabase-artifacts.ts",
    "build:boundary:check": "tsx scripts/check-client-bundle.ts",
    "registration:provision": "tsx scripts/manage-employer-provision.ts issue",
    "registration:revoke": "tsx scripts/manage-employer-provision.ts revoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.109.0",
    "next": "16.3.2",
    "openai": "^6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  }
}
