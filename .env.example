APP_ENV=local
APP_BUILD_SHA=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-anon-key-from-supabase-status
SUPABASE_REGISTRATION_SECRET_KEY=server-only-local-secret-key
REGISTRATION_CODE_PEPPER=replace-with-at-least-32-random-characters
REGISTRATION_FINGERPRINT_PEPPER=replace-with-a-different-32-character-secret
REGISTRATION_MAIL_MODE=http
REGISTRATION_MAIL_ENDPOINT=https://mail-provider.example.test/send
REGISTRATION_MAIL_TOKEN=server-only-provider-token
# Test-only, with loopback Supabase and APP_ENV=test:
REGISTRATION_TEST_MAILBOX_TOKEN=local-test-mailbox-token
CONVERSATION_PROVIDER=fake
CONVERSATION_FAKE_MODE=normal
CONVERSATION_PROVIDER_RATE_LIMIT_MAX=20
OPENAI_PROVIDER_ENABLED=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=provider_default
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_RETRIES=1
OPENAI_EVALUATION_DIAGNOSTICS_ENABLED=false
OPENAI_API_KEY=replace-only-when-running-an-authorised-live-provider-review
